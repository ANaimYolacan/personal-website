---
interface Props {
  title?: string;
}

const { title = "Naim Yolacan" } = Astro.props;
---

<!doctype html>
<html lang="tr" class="notranslate" translate="no">
  <head>
    <meta charset="utf-8" />
    <meta name="google" content="notranslate" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0" />
    <meta name="theme-color" content="#0a0a0a" />
    <title>{title}</title>
    
    <!-- Meta Açıklama (SEO için) -->
    <meta name="description" content="Abdullah Naim Yolacan - AI & Machine Learning" />

    <!-- Open Graph / Facebook / LinkedIn vb. -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://naimyolacan.com/" />
    <meta property="og:title" content="Naim Yolacan | AI & Machine Learning" />
    <meta property="og:description" content="Abdullah Naim Yolacan - AI & Machine Learning" />
    <!-- Siteniz yayına girdiğinde tam çalışması için URL'in mutlak olması tercih edilir -->
    <meta property="og:image" content="https://naimyolacan.com/og-image.png" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://naimyolacan.com/" />
    <meta name="twitter:title" content="Naim Yolacan | AI & Machine Learning" />
    <meta name="twitter:description" content="Abdullah Naim Yolacan - AI & Machine Learning" />
    <meta name="twitter:image" content="https://naimyolacan.com/og-image.png" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
  html[lang="en"] .tr-text { display: none !important; }
  html[lang="tr"] .en-text { display: none !important; }
</style>

<script>
  // Sayfa yüklendiğinde dili kontrol et
  const setLang = () => {
    const savedLang = localStorage.getItem('site-lang') || 'en';
    document.documentElement.lang = savedLang;
    
    // Aktif butonları güncelle
    document.querySelectorAll('.lang-btn').forEach(btn => {
      if (btn.textContent.toLowerCase() === savedLang) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });
  };

  // İlk yüklemede çalıştır
  setLang();
  
  // Astro sayfa geçişleri için (ViewTransitions kullanılıyorsa)
  document.addEventListener('astro:page-load', setLang);

  // Butonlara tıklanınca dili değiştir
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('.lang-btn');
    if (!btn) return;
    
    const newLang = btn.textContent.toLowerCase();
    localStorage.setItem('site-lang', newLang);
    setLang();
  });
</script>
