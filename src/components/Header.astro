---
// Header Component
---

<header class="header">
  <!-- Sol boşluk (Grid dengelemesi için) -->
  <div class="header__left"></div>

  <!-- Orta Navigasyon -->
  <nav class="header__nav glass-pill">
    <a href="#hero" class="nav-link">Home</a>
    <span class="separator">.</span>
    <a href="#about" class="nav-link">About</a>
    <span class="separator">.</span>
    <a href="#projects" class="nav-link">Projects</a>
    <span class="separator">.</span>
    <a href="#contact" class="nav-link">Contact</a>
  </nav>

  <!-- Sağ Dil Seçenekleri -->
  <div class="header__right glass-pill">
    <button class="lang-btn active">en</button>
    <span class="lang-separator">|</span>
    <button class="lang-btn">tr</button>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    padding: 2.5vh 3vw;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    z-index: 50; /* Tüm içeriğin üstünde */
  }

  .header__left {
    /* Sol sütun boş kalacak */
  }

  /* Cam Efekti (Glassmorphism) Ortak Sınıfı */
  .glass-pill {
    background: rgba(20, 20, 20, 0.45); /* Biraz daha koyu/şeffaf */
    backdrop-filter: blur(28px); /* Blur efekti artırıldı */
    -webkit-backdrop-filter: blur(28px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 1.5vw;
    justify-content: center;
    padding: 0.75rem 2rem;
  }

  .header__right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    justify-self: end;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
  }

  /* Basit Tipografi */
  .nav-link,
  .lang-btn,
  .separator,
  .lang-separator {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text-primary);
    text-decoration: none;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: color 0.3s ease; /* Yumuşak renk geçişi */
  }

  .lang-btn {
    text-transform: uppercase;
    font-size: 0.95rem;
    letter-spacing: 0.05em;
  }

  /* Noktalar (Separatörler) */
  .separator {
    opacity: 0.5;
    transform: translateY(-2px);
  }

  .lang-separator {
    opacity: 0.5;
    font-size: 0.9rem;
  }

  /* Hover ve Aktif Durumları */
  .nav-link:hover,
  .lang-btn:hover {
    color: var(--color-accent);
  }

  .lang-btn.active {
    font-weight: 700;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollToPlugin } from "gsap/ScrollToPlugin";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  
  gsap.registerPlugin(ScrollToPlugin, ScrollTrigger);

  function initHeaderNavigation() {
    const navLinks = document.querySelectorAll('.nav-link');
    
    navLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        const targetId = link.getAttribute('href');
        if (targetId && targetId.startsWith('#')) {
          e.preventDefault();
          
          // Header tıklandığında Projects vb. sectionlara haber vermek için global event
          window.dispatchEvent(new CustomEvent('nav-scroll-start'));
          
          document.body.classList.add('is-nav-scrolling');

          gsap.to(window, {
            scrollTo: { y: targetId, autoKill: false },
            duration: 1.4, /* Yumuşak bir süre */
            ease: "power3.inOut",
            onComplete: () => {
              window.dispatchEvent(new CustomEvent('nav-scroll-end'));
              document.body.classList.remove('is-nav-scrolling');
            }
          });
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initHeaderNavigation);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeaderNavigation);
  } else {
    initHeaderNavigation();
  }
</script>
