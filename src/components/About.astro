---
// About Section — Bento Grid UI
---

<section id="about" class="about js-about-section">
  <!-- Arka plan ve Grid Dokusu (Aynı kalıyor) -->
  <div class="about__bg"></div>
  <div class="about__grid"></div>

  <!-- Bento Konteyner -->
  <div class="bento-container js-bento-container">
    
    <!-- Kutu 1: Ana Intro (2 Sütun Kaplar) -->
    <div class="bento-box box-intro js-bento-box">
      <h2 class="bento__title">About Me</h2>
      <p class="bento__text">
        I'm Naim Yolacan — an AI & Machine Learning enthusiast passionate about turning raw data into meaningful, human-centered experiences. I believe technology should serve people, not the other way around.
      </p>
    </div>

    <!-- Kutu 2: Portre Görseli (1 Sütun, 2 Satır Kaplar) -->
    <div class="bento-box box-portrait js-bento-box">
      <img src="/images/hero.png" alt="Naim Yolacan" class="bento__img" />
    </div>

    <!-- Kutu 3: Motivasyon (1 Sütun Kaplar) -->
    <div class="bento-box box-focus js-bento-box">
      <h3>Dig Deeper.</h3>
      <p class="bento__text">Curiosity drives everything I build and explore.</p>
    </div>

    <!-- Kutu 4: Ne Yapıyorum (2 Sütun Kaplar) -->
    <div class="bento-box box-whatido js-bento-box">
      <h3>What I Do</h3>
      <p class="bento__text">
        I design and develop intelligent systems that bridge the gap between complex algorithms and elegant interfaces. From deep learning models to full-stack web applications, I enjoy working across the entire stack.
      </p>
    </div>

    <!-- Kutu 5: İletişim (1 Sütun Kaplar) -->
    <div class="bento-box box-connect js-bento-box">
      <span class="big-text">Connect.</span>
      <p class="bento__text">Always open to new collaborations.</p>
    </div>

    <!-- Kutu 6: Yetenekler / Toolkit (Tüm satırı kaplar) -->
    <div class="bento-box box-toolkit js-bento-box">
      <h3>My Toolkit</h3>
      <div class="toolkit-tags">
        <span>Python</span>
        <span>TensorFlow</span>
        <span>PyTorch</span>
        <span>Scikit-learn</span>
        <span>JavaScript</span>
        <span>TypeScript</span>
        <span>React</span>
        <span>Astro</span>
        <span>Node.js</span>
        <span>SQL</span>
      </div>
    </div>

  </div>
</section>

<style>
  /* ===== SECTION CONTAINER ===== */
  .about {
    position: relative;
    z-index: 12;
    background-color: #080000; 
    min-height: 100vh;
    padding: 10vh 0; /* Üstten ve alttan nefes alma boşluğu */
  }

  /* Crimson Gradient Doku (Sabit) */
  .about__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .about__bg::before,
  .about__bg::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
  }
  .about__bg::before {
    width: 900px;
    height: 600px;
    top: -15%;
    right: -10%;
    background: radial-gradient(ellipse at 40% 50%, rgba(120, 10, 30, 0.25) 0%, rgba(60, 5, 15, 0.12) 50%, transparent 80%);
  }
  .about__bg::after {
    width: 1100px;
    height: 700px;
    bottom: -20%;
    left: -15%;
    background: radial-gradient(ellipse at 60% 50%, rgba(140, 15, 35, 0.2) 0%, rgba(50, 5, 12, 0.1) 50%, transparent 80%);
  }

  /* Grid Deseni (Sabit) */
  .about__grid {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: calc(100% + 50vh); /* Taşırma efekti */
    z-index: 1;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(220, 20, 60, 0.15) 1px, transparent 1px),
      linear-gradient(90deg, rgba(220, 20, 60, 0.15) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 90% 80% at 50% 40%, black 20%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 90% 80% at 50% 40%, black 20%, transparent 80%);
  }

  /* ===== BENTO GRID SİSTEMİ ===== */
  .bento-container {
    position: relative;
    z-index: 2; /* Arka planların üstünde */
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 4vw;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: minmax(220px, auto);
    gap: 1.5rem;
  }

  /* Ortak Kutu Stilleri */
  .bento-box {
    background: rgba(20, 20, 20, 0.5);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 32px;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: var(--color-text-primary);
    overflow: hidden;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .bento-box:hover {
    border-color: rgba(255, 255, 255, 0.18);
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.08);
    transform: translateY(-4px);
  }

  /* Grid Yerleşimleri (Desktop) */
  .box-intro { grid-column: span 2; grid-row: span 1; }
  .box-portrait { grid-column: span 1; grid-row: span 2; padding: 0; }
  .box-focus { grid-column: span 1; grid-row: span 1; }
  .box-whatido { grid-column: span 2; grid-row: span 1; }
  .box-connect { grid-column: span 1; grid-row: span 1; }
  .box-toolkit { grid-column: span 4; grid-row: span 1; }

  /* İçerik Tipografisi */
  .bento__title {
    font-family: var(--font-sans);
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 900;
    margin: 0 0 1rem 0;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .bento-box h3 {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-crimson-500);
    margin: 0 0 0.75rem 0;
  }

  .big-text {
    font-size: 2.2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .bento__text {
    font-size: 1.05rem;
    line-height: 1.6;
    opacity: 0.8;
    margin: 0;
  }

  /* Portre Görseli */
  .bento__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    opacity: 0.8;
    filter: grayscale(20%);
    transition: transform 0.5s ease, filter 0.5s ease;
  }
  
  .box-portrait:hover .bento__img {
    transform: scale(1.05);
    filter: grayscale(0%);
  }

  /* Toolkit (Yetenekler) Etiketleri */
  .toolkit-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .toolkit-tags span {
    background: rgba(220, 20, 60, 0.1);
    color: var(--color-crimson-100);
    border: 1px solid rgba(220, 20, 60, 0.2);
    padding: 0.5rem 1rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    transition: all 0.2s ease;
  }

  .toolkit-tags span:hover {
    background: rgba(220, 20, 60, 0.25);
    border-color: rgba(220, 20, 60, 0.4);
  }

  /* ===== RESPONSIVE YAPISI ===== */
  @media (max-width: 1024px) {
    .bento-container {
      grid-template-columns: repeat(3, 1fr);
    }
    .box-intro { grid-column: span 2; }
    .box-portrait { grid-column: span 1; grid-row: span 2; }
    .box-focus { grid-column: span 1; }
    .box-whatido { grid-column: span 2; }
    .box-connect { grid-column: span 1; }
    .box-toolkit { grid-column: span 3; }
  }

  @media (max-width: 768px) {
    .bento-container {
      grid-template-columns: 1fr;
    }
    .box-intro, .box-portrait, .box-focus, .box-whatido, .box-connect, .box-toolkit {
      grid-column: span 1;
      grid-row: auto;
    }
    .box-portrait {
      min-height: 400px; /* Mobilde portreye sabit yükseklik verelim */
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  function initBento() {
    import("gsap/ScrollTrigger").then(({ ScrollTrigger }) => {
      gsap.registerPlugin(ScrollTrigger);

      // Önceki ScrollTrigger'ları temizle (Eğer sayfalar arası geçiş yapıyorsak)
      ScrollTrigger.getAll().forEach(st => {
        if(st.vars.trigger === '.js-bento-container' || st.vars.trigger === '.js-about-section') {
          st.kill();
        }
      });

      const boxes = gsap.utils.toArray('.js-bento-box') as HTMLElement[];
      if (boxes.length === 0) return;

      // Kutu giriş animasyonu (Aşağıdan yukarı yumuşak Fade-in)
      gsap.fromTo(boxes, 
        { 
          y: 60, 
          opacity: 0 
        }, 
        {
          y: 0, 
          opacity: 1, 
          duration: 0.8, 
          stagger: 0.1, 
          ease: "power3.out",
          scrollTrigger: {
            trigger: ".js-bento-container",
            start: "top 85%", // Kapsayıcı ekranın %85'ine geldiğinde başla
            toggleActions: "play none none reverse" // Aşağı inerken oynat, yukarı çıkarken geri al
          }
        }
      );
    });
  }

  document.addEventListener('astro:page-load', initBento);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBento);
  } else {
    initBento();
  }
</script>
