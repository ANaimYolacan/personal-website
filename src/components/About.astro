---
// About Section — Bento Grid UI
---

<section id="about" class="about js-about-section">
  <!-- Arka plan ve Grid Dokusu (Aynı kalıyor) -->
  <div class="about__bg"></div>
  <div class="about__grid"></div>

  <!-- Bento Konteyner -->
  <div class="bento-container js-bento-container">
    
    <!-- Kutu 1: Giriş / Bio (2 Sütun Kaplar) -->
    <div class="bento-box box-intro js-bento-box">
      <h2 class="bento__title">
        <span class="en-text">About Me</span>
        <span class="tr-text">Hakkımda</span>
      </h2>
      <p class="bento__text">
        <span class="en-text">I'm Abdullah Naim Yolaçan, an AI & Machine Learning major passionate about turning data into human-centered experiences. Besides technology, I am a huge fan of all sorts of art.</span>
        <span class="tr-text">Ben Abdullah Naim Yolaçan, verileri insan odaklı deneyimlere dönüştürmeye hevesli bir Yapay Zeka ve Makine Öğrenmesi bölümü öğrencisiyim. Teknolojinin yanı sıra, sanatın her türüne büyük bir ilgim var.</span>
      </p>
    </div>

    <!-- Kutu 2: Portre Görseli (1 Sütun, 2 Satır Kaplar) -->
    <div class="bento-box box-portrait js-bento-box">
      <img src="/images/hero.webp" alt="Naim Yolacan" class="bento__img" loading="lazy" decoding="async" />
    </div>

    <!-- Kutu 3: Resume (1 Sütun Kaplar) -->
    <a href="/resume.pdf" target="_blank" class="bento-box box-focus box-resume js-bento-box">
      <div class="resume-header">
        <h3 class="resume-title">
          <span class="resume-title__top">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-crimson-500)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="resume-icon">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span class="en-text">Download</span>
            <span class="tr-text">Özgeçmişimi</span>
          </span>
          <span class="resume-title__bottom">
            <span class="en-text">My Resume</span>
            <span class="tr-text">İndir</span>
          </span>
        </h3>
      </div>
      <p class="bento__text">
        <span class="en-text">Get a complete overview of my education, technical skills, and professional journey.</span>
        <span class="tr-text">Eğitimim, teknik yeteneklerim ve profesyonel yolculuğuma dair tam bir genel bakış elde edin.</span>
      </p>
    </a>

    <!-- Kutu 4: Ne Yapıyorum (2 Sütun Kaplar) -->
    <div class="bento-box box-whatido js-bento-box">
      <h3>
        <span class="en-text">What I Do</span>
        <span class="tr-text">Neler Yapıyorum</span>
      </h3>
      <p class="bento__text">
        <span class="en-text">I design and develop intelligent systems. I am currently working on a self-guiding missile system. I enjoy playing my guitar and glass-work in open flame in my free time.</span>
        <span class="tr-text">Akıllı sistemler tasarlıyor ve geliştiriyorum. Şu anda kendi kendini yönlendiren bir füze sistemi üzerinde çalışıyorum. Boş zamanlarımda gitar çalmaktan ve açık ateşte cam işçiliği yapmaktan keyif alıyorum.</span>
      </p>
    </div>

    <!-- Kutu 5: İletişim (1 Sütun Kaplar) -->
    <a href="https://www.linkedin.com/in/abdullah-naim-yolacan" target="_blank" rel="noopener noreferrer" class="bento-box box-connect js-bento-box">
      <div class="connect-header">
        <span class="big-text">
          <span class="en-text">Connect.</span>
          <span class="tr-text">Bağlan.</span>
        </span>
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--color-crimson-500)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="connect-icon">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
          <rect x="2" y="9" width="4" height="12"></rect>
          <circle cx="4" cy="4" r="2"></circle>
        </svg>
      </div>
      <p class="bento__text">
        <span class="en-text">Always open to new collaborations.</span>
        <span class="tr-text">Yeni işbirliklerine her zaman açığım.</span>
      </p>
    </a>

    <!-- Kutu 6: Yetenekler / Toolkit (Tüm satırı kaplar) -->
    <div class="bento-box box-toolkit js-bento-box">
      <h3>
        <span class="en-text">My Toolkit</span>
        <span class="tr-text">Yeteneklerim</span>
      </h3>
      <div class="toolkit-tags">
        <span>Python</span>
        <span>MATLAB</span>
        <span>SQL</span>
        <span>PyTorch</span>
        <span>TensorFlow</span>
        <span>scikit-learn</span>
        <span>Pandas</span>
        <span>NumPy</span>
        <span>Seaborn</span>
        <span>Keras</span>
        <span>OpenCV</span>
        <span>Git & GitHub</span>
        <span>Docker (Basic)</span>
      </div>
    </div>

  </div>
</section>

<style>
  /* ===== SECTION CONTAINER ===== */
  .about {
    position: relative;
    z-index: 12;
    background-color: #080000; 
    min-height: 100vh;
    padding: 10vh 0; /* Üstten ve alttan nefes alma boşluğu */
  }

  /* Crimson Gradient Doku (Sabit) */
  .about__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .about__bg::before,
  .about__bg::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
  }
  .about__bg::before {
    width: 900px;
    height: 600px;
    top: -15%;
    right: -10%;
    background: radial-gradient(ellipse at 40% 50%, rgba(120, 10, 30, 0.25) 0%, rgba(60, 5, 15, 0.12) 50%, transparent 80%);
  }
  .about__bg::after {
    width: 1100px;
    height: 700px;
    bottom: -20%;
    left: -15%;
    background: radial-gradient(ellipse at 60% 50%, rgba(140, 15, 35, 0.2) 0%, rgba(50, 5, 12, 0.1) 50%, transparent 80%);
  }

  /* Grid Deseni (Sabit) */
  .about__grid {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: calc(100% + 50vh); /* Taşırma efekti */
    z-index: 1;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(220, 20, 60, 0.15) 1px, transparent 1px),
      linear-gradient(90deg, rgba(220, 20, 60, 0.15) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 90% 80% at 50% 40%, black 20%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 90% 80% at 50% 40%, black 20%, transparent 80%);
  }

  /* ===== BENTO GRID SİSTEMİ ===== */
  .bento-container {
    position: relative;
    z-index: 2; /* Arka planların üstünde */
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 4vw;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: minmax(220px, auto);
    gap: 1.5rem;
  }

  /* Ortak Kutu Stilleri */
  .bento-box {
    background: rgba(20, 20, 20, 0.5);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 32px;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: var(--color-text-primary);
    overflow: hidden;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .bento-box:hover {
    border-color: rgba(255, 255, 255, 0.18);
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.08);
    transform: translateY(-4px);
  }

  /* Grid Yerleşimleri (Desktop) */
  .box-intro { grid-column: span 2; grid-row: span 1; }
  .box-portrait { grid-column: span 1; grid-row: span 2; padding: 0; }
  .box-focus { grid-column: span 1; grid-row: span 1; }
  .box-whatido { grid-column: span 2; grid-row: span 1; }
  .box-connect { grid-column: span 1; grid-row: span 1; }
  .box-toolkit { grid-column: span 4; grid-row: span 1; }

  /* İçerik Tipografisi */
  .bento__title {
    font-family: var(--font-sans);
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 900;
    margin: 0 0 1rem 0;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .bento-box h3 {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-crimson-500);
    margin: 0 0 0.75rem 0;
  }

  /* Resume Card Özel CSS */
  .box-resume {
    text-decoration: none;
    cursor: pointer;
    background: rgba(220, 20, 60, 0.05); /* Crimson tonu belirginleştirildi */
    border-color: rgba(220, 20, 60, 0.15);
  }

  .box-resume:hover {
    background: rgba(220, 20, 60, 0.1);
    border-color: rgba(220, 20, 60, 0.3);
  }

  .resume-header {
    margin-bottom: 0.5rem;
  }

  .resume-title {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .resume-title__top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .resume-title__bottom {
    display: block;
    /* İkonun sağında (Download kelimesinin hizasında) başlamasını isterseniz margin-left: 22px + gap kullanabilirdik,
       fakat ikonla aynı sol hizada başlamasını istediğiniz için margin vermiyoruz. */
  }

  .resume-icon {
    /* İkon zaten svg içinde crimson yapıldı */
    opacity: 0.9;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .box-resume:hover .resume-icon {
    opacity: 1;
    transform: translateY(3px); /* Biraz daha belirgin aşağı hareket */
  }

  .box-connect {
    text-decoration: none;
    cursor: pointer;
  }

  .connect-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
  }

  .connect-icon {
    opacity: 0.8;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .box-connect:hover .connect-icon {
    opacity: 1;
    transform: scale(1.1) rotate(5deg);
  }

  .box-connect:hover {
    border-color: rgba(220, 20, 60, 0.3);
  }

  .big-text {
    font-size: 2.2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .bento__text {
    font-size: 1.05rem;
    line-height: 1.6;
    opacity: 0.8;
    margin: 0;
  }

  /* Portre Görseli */
  .bento__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    opacity: 0.8;
    filter: grayscale(20%);
    transition: transform 0.5s ease, filter 0.5s ease;
  }
  
  .box-portrait:hover .bento__img {
    transform: scale(1.05);
    filter: grayscale(0%);
  }

  /* Toolkit (Yetenekler) Etiketleri */
  .toolkit-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .toolkit-tags span {
    background: rgba(220, 20, 60, 0.1);
    color: var(--color-crimson-100);
    border: 1px solid rgba(220, 20, 60, 0.2);
    padding: 0.5rem 1rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    transition: all 0.2s ease;
  }

  .toolkit-tags span:hover {
    background: rgba(220, 20, 60, 0.25);
    border-color: rgba(220, 20, 60, 0.4);
  }

  /* ===== RESPONSIVE YAPISI ===== */
  @media (max-width: 1024px) {
    .bento-container {
      grid-template-columns: repeat(3, 1fr);
    }
    .box-intro { grid-column: span 2; }
    .box-portrait { grid-column: span 1; grid-row: span 2; }
    .box-focus { grid-column: span 1; }
    .box-whatido { grid-column: span 2; }
    .box-connect { grid-column: span 1; }
    .box-toolkit { grid-column: span 3; }
  }

  @media (max-width: 768px) {
    .bento-container {
      grid-template-columns: 1fr;
      padding: 0 5vw;
      gap: 1rem;
    }
    .bento-box {
      padding: 1.5rem;
      border-radius: 24px;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }
    .bento__title {
      font-size: 2.8rem;
    }
    .bento__text {
      font-size: 0.95rem;
    }
    .box-intro, .box-portrait, .box-focus, .box-whatido, .box-connect, .box-toolkit {
      grid-column: span 1;
      grid-row: auto;
    }
    .box-portrait {
      min-height: 300px;
    }

    /* Mobil Kart Sıralaması: About Me → Portre → What I Do → Toolkit → Dig Deeper → Connect */
    .box-intro    { order: 1; } /* About Me */
    .box-portrait { order: 2; } /* Portre */
    .box-whatido  { order: 3; } /* What I Do */
    .box-toolkit  { order: 4; } /* Toolkit */
    .box-focus    { order: 5; } /* Dig Deeper */
    .box-connect  { order: 6; } /* Connect */
  }
</style>

<script>
  import { gsap } from "gsap";

  function initBento() {
    import("gsap/ScrollTrigger").then(({ ScrollTrigger }) => {
      gsap.registerPlugin(ScrollTrigger);

      // Önceki ScrollTrigger'ları temizle (Eğer sayfalar arası geçiş yapıyorsak)
      ScrollTrigger.getAll().forEach(st => {
        if(st.vars.trigger === '.js-bento-container' || st.vars.trigger === '.js-about-section') {
          st.kill();
        }
      });

      const boxes = gsap.utils.toArray('.js-bento-box') as HTMLElement[];
      if (boxes.length === 0) return;

      // Kutu giriş animasyonu (Aşağıdan yukarı yumuşak Fade-in)
      gsap.fromTo(boxes, 
        { 
          y: 60, 
          opacity: 0 
        }, 
        {
          y: 0, 
          opacity: 1, 
          duration: 0.8, 
          stagger: 0.1, 
          ease: "power3.out",
          scrollTrigger: {
            trigger: ".js-bento-container",
            start: "top 85%", // Kapsayıcı ekranın %85'ine geldiğinde başla
            toggleActions: "play none none reverse" // Aşağı inerken oynat, yukarı çıkarken geri al
          }
        }
      );
    });
  }

  document.addEventListener('astro:page-load', initBento);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBento);
  } else {
    initBento();
  }
</script>
