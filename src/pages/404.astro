---
import Layout from '../layouts/BaseLayout.astro';
---

<Layout title="404 - Page Not Found">
  <main class="error-page">
    
    <!-- SVG Animasyonlu Arka Plan (Hero'daki gibi) -->
    <div class="error__svg-bg">
      <svg class="hero__topology-bg" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <defs>
          <filter id="gooey-morph" x="-20%" y="-20%" width="140%" height="140%">
            <feTurbulence type="fractalNoise" baseFrequency="0.005 0.005" numOctaves="3" result="noise" seed="1">
              <animate attributeName="baseFrequency" dur="30s" values="0.005 0.005; 0.009 0.007; 0.005 0.005" repeatCount="indefinite" />
            </feTurbulence>
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="180" xChannelSelector="R" yChannelSelector="G" />
          </filter>
        </defs>
        
        <g filter="url(#gooey-morph)" stroke="var(--color-crimson-500)" stroke-width="1.5" fill="none" opacity="0.4">
          <circle cx="50%" cy="50%" r="5%"></circle>
          <circle cx="50%" cy="50%" r="15%"></circle>
          <circle cx="50%" cy="50%" r="25%"></circle>
          <circle cx="50%" cy="50%" r="35%"></circle>
          <circle cx="50%" cy="50%" r="45%"></circle>
          <circle cx="50%" cy="50%" r="55%"></circle>
          <circle cx="50%" cy="50%" r="65%"></circle>
          <circle cx="50%" cy="50%" r="75%"></circle>
          <circle cx="50%" cy="50%" r="85%"></circle>
          <circle cx="50%" cy="50%" r="95%"></circle>
          <circle cx="50%" cy="50%" r="105%"></circle>
          <circle cx="50%" cy="50%" r="115%"></circle>
          <circle cx="50%" cy="50%" r="125%"></circle>
        </g>
      </svg>
    </div>

    <!-- Karartma/Geçiş Efekti (Kenarlar kararsın, merkez odakta kalsın) -->
    <div class="error__vignette"></div>

    <!-- Sol Üst: Anasayfaya Dön Butonu (Header Tarzı) -->
    <a href="/" class="back-btn glass-pill">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      <span class="en-text">Back to Home</span>
      <span class="tr-text">Ana Sayfaya Dön</span>
    </a>

    <!-- Merkez: Bento Tarzı 404 Kartı -->
    <div class="error-card bento-box">
      <h1 class="error-code">404</h1>
      <p class="error-text">
        <span class="en-text">Page Not Found</span>
        <span class="tr-text">Sayfa Bulunamadı</span>
      </p>
    </div>

  </main>
</Layout>

<style>
  /* Sayfa Temeli */
  .error-page {
    position: relative;
    width: 100%;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #080000;
    overflow: hidden;
  }

  /* Arka Plan SVG */
  .error__svg-bg {
    position: absolute;
    inset: -10%; /* Dalgalar kenarlardan taşmasın diye */
    width: 120%;
    height: 120%;
    z-index: 1;
    pointer-events: none;
    transform: translateZ(0);
  }
  
  .hero__topology-bg {
    width: 100%;
    height: 100%;
  }

  /* Vinyet Efekti */
  .error__vignette {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: radial-gradient(circle at center, transparent 0%, #080000 80%);
    pointer-events: none;
  }

  /* Sol Üst Buton */
  .back-btn {
    position: absolute;
    top: 2.5vh;
    left: 3vw;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    text-decoration: none;
    color: var(--color-text-primary);
    font-size: 0.9rem;
    font-weight: 500;
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .back-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .back-btn svg {
    transition: transform 0.3s ease;
  }

  .back-btn:hover svg {
    transform: translateX(-4px);
  }

  /* Merkez Kart (Bento Stili) */
  .bento-box {
    position: relative;
    z-index: 5;
    background: rgba(20, 20, 20, 0.6);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 32px;
    padding: 4rem 5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    color: var(--color-text-primary);
    text-align: center;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    animation: fadeUp 0.8s ease-out forwards;
  }

  .bento-box:hover {
    border-color: rgba(220, 20, 60, 0.3); /* Hover'da crimson çizgisi */
    box-shadow: 0 12px 48px rgba(220, 20, 60, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.08);
    transform: translateY(-4px);
  }

  /* İçerik Yazıları */
  .error-code {
    font-family: var(--font-sans);
    font-size: clamp(6rem, 12vw, 10rem);
    font-weight: 900;
    line-height: 1;
    margin: 0;
    color: var(--color-crimson-500);
    letter-spacing: -0.05em;
  }

  .error-text {
    font-size: clamp(1.2rem, 3vw, 1.8rem);
    font-weight: 500;
    margin: 1rem 0 0 0;
    opacity: 0.8;
    letter-spacing: 0.05em;
  }

  /* Animasyon */
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Mobil Uyum */
  @media (max-width: 768px) {
    .back-btn {
      top: 1.5rem;
      left: 1.5rem;
      padding: 0.5rem 1rem;
      font-size: 0.85rem;
    }
    .bento-box {
      padding: 3rem 2rem;
      width: 85%;
    }
  }
</style>
